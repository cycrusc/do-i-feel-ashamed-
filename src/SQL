create database FinalProject;
use FinalProject;

--drop database FinalProject; -- incase of emergency

create table ROLE_ (
	Role_ID int identity(1,1) constraint PK_Role primary key,
	Role_Name varchar(50) not null constraint UQ_Role_Name unique,
	Descriptions varchar(100)
);

create table SUPPLIER (
	Supplier_ID int identity(1,1) constraint PK_Supplier primary key,
	Supplier_Name varchar(50) not null,
	Contact_Info varchar(100),
	-- brokedown the multi-valued field
	Barangay varchar(25) not null,
    Municipality varchar(25) not null,
    City varchar(25) not null
);

create table PRODUCT_ (
	product_code varchar(50) constraint PK_Product primary key,
    brand_name varchar(50), -- added brand name
	product_name varchar(50) not null,
	category varchar(50),
	unit_price decimal(10,2) not null constraint CK_Product_Price check(Unit_Price >= 0)
);

create table EMPLOYEE (
    employee_id int identity(1,1) constraint PK_Employee primary key,
    role_id int not null,
    -- brokedown the multi-valued field
    Fname varchar(25) not null,
    Mname varchar(25),
    Lname varchar(25) not null,

    constraint FK_Employee_Role foreign key (role_id) references ROLE_(role_id)
);

create table INVENTORY (
    inventory_id int identity(1,1) constraint PK_Inventory primary key,
    product_code varchar(50) not null,
    stock_quantity int not null constraint DF_Inventory_Stock default 0 constraint CK_Inventory_Stock check(stock_quantity >= 0),

    constraint FK_Inventory_Product foreign key(product_code) references PRODUCT_(product_code)
);

create table SUPPLY_RECORD (
    supply_id int identity(1,1) constraint PK_SupplyRecord primary key,
    supplier_id int not null,
    product_code varchar(50) not null,
    order_date date NOT NULL constraint DF_Supply_Date default getdate(),
    quantity_supplied int not null constraint CK_Supply_Qty check(quantity_supplied > 0),
    unit_cost decimal(10,2) not null constraint CK_Supply_Cost check(unit_cost >= 0),

    constraint FK_Supply_Supplier foreign key(supplier_id)  references SUPPLIER(supplier_id),
    constraint FK_Supply_Product foreign key(product_code) references PRODUCT_(product_code)
);


create table DEALER (
    dealer_ID int identity(1,1) constraint PK_Dealer primary key,
    dealer_name varchar(100) not null,
    contact_number varchar(25),
    email_address varchar(50) not null,
    sponsor_ID int null,   -- NULL = top-level dealer

    constraint FK_Dealer_Sponsor foreign key(sponsor_ID) references DEALER(dealer_ID),
    constraint CK_Dealer_NoSelfSponsor check(sponsor_ID <> dealer_ID)
);


create table DEALER_ORDER (
    Order_id int identity(1,1) constraint PK_DealerOrder primary key,
    Dealer_id int not null,
    employee_id int not null,
    Order_date date not null constraint DF_Order_Date default getdate(),
    payment_method  varchar(30) null,
    payment_date date not null,      -- NULL = not yet paid
    amount_paid decimal(12,2) null constraint CK_Order_Amount check(amount_paid >= 0),

    constraint FK_Order_Dealer foreign key (Dealer_id) references DEALER(dealer_ID),
    constraint FK_Order_Employee foreign key (employee_id) references EMPLOYEE(employee_id),
    constraint CK_Order_PayDate check (payment_date is null or payment_date >= Order_date)
);


create table ORDER_DETAIL (
    Order_id int not null,
    product_code varchar(50) not null,
    quantity int not null constraint CK_Detail_Qty check (quantity > 0),

    constraint PK_OrderDetail primary key(Order_id, product_code),  -- composite key
    constraint FK_Detail_Order foreign key (Order_id) references DEALER_ORDER(Order_id),
    constraint FK_Detail_Product foreign key (product_code) references PRODUCT_(product_code)
);



