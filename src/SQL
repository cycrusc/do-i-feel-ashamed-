-- ---------------------------------------------------------------------
-- REPORT 1: Product Catalog Summary by Category
-- Purpose : How many products each category has and its price range.
-- Importance: this query helps the business understand the number of products in each
-- category and compare their prices for better inventory planning and pricing decisions.
-- ---------------------------------------------------------------------
select  Category,
        count(*) as Total_Products_Per_Category,
        min(Unit_Price) as Lowest_Price,
        max(Unit_Price) as Highest_Price,
        cast(avg(Unit_Price) as decimal(10,2)) as Average_Price
from PRODUCT_
group by Category
order by Total_Products_Per_Category desc, category desc;


-- ---------------------------------------------------------------------
-- REPORT 2: Low-Stock Alert (Reorder List)
-- Purpose : Products the Inventory Clerk should restock (20 units or less).
-- Importance: this query helps the inventory clerk identify products that need restocking
-- to prevent shortages and ensure product availability.
-- ---------------------------------------------------------------------
select  p.Product_Code,
        p.Product_Name,
        p.Category,
        i.Stock_Quantity,
        20 - i.Stock_Quantity as Units_Below_Target
from INVENTORY as i JOIN PRODUCT_ as p
on p.Product_Code = i.Product_Code
where i.Stock_Quantity <= 20
order by i.Stock_Quantity, p.Product_Code;

-- ---------------------------------------------------------------------
-- REPORT 3: Inventory Value by Category (with grand total)
-- Purpose : Total units and peso value of stock held per category.
-- Importance: this query helps the business monitor the total value of its inventory
-- and determine which categories hold the most stock value.
-- ---------------------------------------------------------------------
select  isnull(p.Category, 'GRAND TOTAL') as Category,
        sum(i.Stock_Quantity) as Total_Units,
        sum(i.Stock_Quantity * p.Unit_Price) as Total_Stock_Value
from INVENTORY as i join PRODUCT_ as p
on p.Product_Code = i.Product_Code
group by rollup(p.Category)
order by grouping(p.Category), Total_Stock_Value desc;


-- ---------------------------------------------------------------------
-- REPORT 4: Sales by Product
-- Purpose : Units sold, number of orders and revenue for each product sold.
-- Importance: this query helps the business identify best-selling products and
-- evaluate product performance based on sales volume and revenue.
-- ---------------------------------------------------------------------
select  p.Product_Code,
        p.Product_Name,
        p.Category,
        count(distinct od.Order_ID) as Orders_Containing,
        sum(od.Quantity) as Units_Sold,
        sum(od.Quantity * p.Unit_Price) as Revenue
from ORDER_DETAIL as od join PRODUCT_ as p
ON p.Product_Code = od.Product_Code
group by p.Product_Code, p.Product_Name, p.Category
order by Revenue desc, p.Product_Code;

-- ---------------------------------------------------------------------
-- REPORT 5: Sales by Category (with grand total)
-- Purpose : Which product categories generate the most revenue.
-- Importance: this query helps the business determine which product categories
-- generate the most revenue and make better sales and marketing decisions.
-- ---------------------------------------------------------------------
select  isnull(p.Category, 'GRAND TOTAL') as Category,
        SUM(od.Quantity) as Units_Sold,
        SUM(od.Quantity * p.Unit_Price) as Revenue
from ORDER_DETAIL as od join PRODUCT_ as p
on p.Product_Code = od.Product_Code
group by rollup(p.Category)
order by grouping(p.Category), Revenue desc;


-- ---------------------------------------------------------------------
-- REPORT 6: Payment Method Summary
-- Purpose : Number of orders and amount collected per payment method.
-- Importance: this query helps the business track payments received through
-- different payment methods and monitor collected amounts and unpaid orders.
-- ---------------------------------------------------------------------
select  isnull(Payment_Method, 'Unpaid') as Payment_Method,
        count(*) as Orders,
        isnull(sum(Amount_Paid), 0) as Amount_Collected
from DEALER_ORDER
group by Payment_Method
order by Amount_Collected desc;